---
interface Props {
  title: string;
  icon: string;
  description: string;
}

const { title, icon, description } = Astro.props;
---

<div class="card group hover:border-teal/40 border-2 border-transparent flex flex-col gap-4 transition-all duration-200">
  <div class="text-4xl">{icon}</div>
  <div>
    <h3 class="text-lg font-bold text-navy mb-2 group-hover:text-teal transition-colors duration-200">
      {title}
    </h3>
    <p class="text-slate-500 text-sm leading-relaxed">{description}</p>
  </div>
</div>
