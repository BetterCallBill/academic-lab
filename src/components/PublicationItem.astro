---
interface Props {
  title: string;
  authors: string[];
  journal: string;
  year: number;
  doi: string;
  pdf?: string;
  tags: string[];
  featured: boolean;
}

const { title, authors, journal, year, doi, pdf, tags, featured } = Astro.props;

const formattedAuthors = authors.map((author, i) => {
  const isPI = author === 'Yanan Huang';
  const isLast = i === authors.length - 1;
  const separator = isLast ? '' : i === authors.length - 2 ? ', and ' : ', ';
  return { name: author, isPI, separator };
});
---

<div
  class={`bg-white rounded-xl border p-5 hover:shadow-md transition-all duration-200 ${
    featured ? 'border-teal/50 border-l-4 border-l-teal' : 'border-slate-100'
  }`}
  data-tags={tags.join(',')}
  data-year={year}
>
  {featured && (
    <span class="inline-block text-xs font-semibold text-teal uppercase tracking-wide mb-2">
      ★ Featured
    </span>
  )}

  <!-- Authors -->
  <p class="text-sm text-slate-500 mb-1">
    {formattedAuthors.map(({ name, isPI, separator }) => (
      <span>
        <span class={isPI ? 'font-semibold text-slate-700' : ''}>{name}</span>
        {separator}
      </span>
    ))}
  </p>

  <!-- Title -->
  <h3 class="font-semibold text-slate-900 text-base leading-snug mb-1">
    {title}
  </h3>

  <!-- Journal & year -->
  <p class="text-sm text-slate-500 italic mb-3">
    {journal}, {year}
  </p>

  <!-- Tags & links -->
  <div class="flex flex-wrap items-center gap-2">
    {tags.map(tag => (
      <span class="tag bg-slate-100 text-slate-500 text-xs">{tag}</span>
    ))}
    <div class="flex gap-2 ml-auto">
      <a
        href={`https://doi.org/${doi}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-medium text-teal hover:text-teal-dark transition-colors"
      >
        DOI →
      </a>
      {pdf && (
        <a
          href={pdf}
          class="text-xs font-medium bg-teal/10 text-teal hover:bg-teal hover:text-white px-2 py-0.5 rounded transition-colors"
        >
          PDF
        </a>
      )}
    </div>
  </div>
</div>
