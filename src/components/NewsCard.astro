---
interface Props {
  title: string;
  date: Date;
  category: string;
  image?: string;
  excerpt: string;
  slug: string;
}

const { title, date, category, image, excerpt, slug } = Astro.props;

const categoryColors: Record<string, string> = {
  award: 'bg-amber-100 text-amber-700',
  publication: 'bg-blue-100 text-blue-700',
  event: 'bg-purple-100 text-purple-700',
  announcement: 'bg-teal/10 text-teal',
};

const categoryColor = categoryColors[category] ?? 'bg-slate-100 text-slate-600';

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="card flex flex-col group overflow-hidden p-0">
  {image && (
    <div class="w-full h-44 overflow-hidden">
      <img
        src={image}
        alt={title}
        width="400"
        height="176"
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </div>
  )}

  <div class="p-5 flex flex-col flex-1">
    <div class="flex items-center gap-2 mb-3">
      <span class={`tag capitalize ${categoryColor}`}>{category}</span>
      <time class="text-xs text-slate-400" datetime={date.toISOString()}>
        {formattedDate}
      </time>
    </div>

    <h3 class="font-semibold text-navy text-base leading-snug mb-2 group-hover:text-teal transition-colors line-clamp-2">
      {title}
    </h3>

    <p class="text-sm text-slate-500 leading-relaxed mb-4 line-clamp-3 flex-1">
      {excerpt}
    </p>

    <a
      href={`/news/${slug}`}
      class="text-sm font-medium text-teal hover:text-teal-dark transition-colors self-start"
    >
      Read more →
    </a>
  </div>
</article>
