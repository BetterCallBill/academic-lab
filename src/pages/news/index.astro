---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';

const allNews = (await getCollection('news')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const categories = ['all', ...new Set(allNews.map(n => n.data.category))];
---

<BaseLayout
  title="News"
  description="Latest news, announcements, and updates from the Chen Lab at Westfield University."
>
  <!-- Page header -->
  <section class="bg-slate-50 border-b border-slate-100 py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="section-heading text-4xl">News</h1>
      <p class="text-slate-500">Awards, publications, events, and announcements from the Chen Lab.</p>
    </div>
  </section>

  <div
    class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12"
    x-data="{ activeCategory: 'all' }"
  >
    <!-- Category tabs -->
    <div class="flex flex-wrap gap-2 mb-8">
      {categories.map(cat => (
        <button
          x-on:click={`activeCategory = '${cat}'`}
          x-bind:class={`activeCategory === '${cat}' ? 'bg-navy text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'`}
          class="px-4 py-1.5 rounded-full text-sm font-medium transition-colors capitalize"
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- News grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {allNews.map(item => (
        <div x-show={`activeCategory === 'all' || activeCategory === '${item.data.category}'`}>
          <NewsCard
            title={item.data.title}
            date={item.data.date}
            category={item.data.category}
            image={item.data.image}
            excerpt={item.data.excerpt}
            slug={item.slug}
          />
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
