---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allNews = await getCollection('news');
  return allNews.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();

const allNews = (await getCollection('news')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const currentIndex = allNews.findIndex(n => n.slug === item.slug);
const prev = allNews[currentIndex + 1] ?? null;
const next = allNews[currentIndex - 1] ?? null;

const formattedDate = item.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const categoryColors: Record<string, string> = {
  award: 'bg-amber-100 text-amber-700',
  publication: 'bg-blue-100 text-blue-700',
  event: 'bg-purple-100 text-purple-700',
  announcement: 'bg-teal/10 text-teal',
};
const categoryColor = categoryColors[item.data.category] ?? 'bg-slate-100 text-slate-600';
---

<BaseLayout
  title={item.data.title}
  description={item.data.excerpt}
  image={item.data.image}
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <!-- Breadcrumb -->
    <nav class="text-sm text-slate-400 mb-8">
      <a href="/" class="hover:text-teal transition-colors">Home</a>
      <span class="mx-2">›</span>
      <a href="/news" class="hover:text-teal transition-colors">News</a>
      <span class="mx-2">›</span>
      <span class="text-slate-600 line-clamp-1">{item.data.title}</span>
    </nav>

    <!-- Category & date -->
    <div class="flex items-center gap-3 mb-4">
      <span class={`tag capitalize ${categoryColor}`}>{item.data.category}</span>
      <time class="text-sm text-slate-400" datetime={item.data.date.toISOString()}>
        {formattedDate}
      </time>
    </div>

    <!-- Title -->
    <h1 class="text-3xl sm:text-4xl font-bold text-navy leading-tight mb-6">
      {item.data.title}
    </h1>

    <!-- Featured image -->
    {item.data.image && (
      <div class="rounded-2xl overflow-hidden mb-8">
        <img
          src={item.data.image}
          alt={item.data.title}
          class="w-full h-64 sm:h-80 object-cover"
          loading="eager"
        />
      </div>
    )}

    <!-- Body -->
    <div class="prose prose-slate max-w-none prose-headings:text-navy prose-a:text-teal hover:prose-a:text-teal-dark">
      <Content />
    </div>

    <!-- Prev / Next -->
    <nav class="mt-14 pt-8 border-t border-slate-100 grid grid-cols-2 gap-4">
      {prev ? (
        <a href={`/news/${prev.slug}`} class="group text-left">
          <p class="text-xs text-slate-400 uppercase tracking-wide mb-1">← Older</p>
          <p class="text-sm font-medium text-navy group-hover:text-teal transition-colors line-clamp-2">
            {prev.data.title}
          </p>
        </a>
      ) : <div />}
      {next ? (
        <a href={`/news/${next.slug}`} class="group text-right col-start-2">
          <p class="text-xs text-slate-400 uppercase tracking-wide mb-1">Newer →</p>
          <p class="text-sm font-medium text-navy group-hover:text-teal transition-colors line-clamp-2">
            {next.data.title}
          </p>
        </a>
      ) : <div />}
    </nav>
  </article>
</BaseLayout>
